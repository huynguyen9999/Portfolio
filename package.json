{
  "name": "huy-portfolio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "audit:performance": "lighthouse http://localhost:3000 --chrome-flags=\"--headless\" --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=./test-results/lighthouse.html",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser",
    "audit:security": "pnpm audit --audit-level=low",
    "build:verified": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit --audit-level=low && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.8",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.0",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "type": "module"
}
